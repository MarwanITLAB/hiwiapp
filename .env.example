# Vorlage für die Datei .env (liegt neben docker-compose.yml)
# 1. Diese Datei kopieren und ".env" nennen:   cp .env.example .env
# 2. Werte eintragen. Die .env steht in .gitignore und kommt NICHT nach Git.

# ---------- Datenbank ----------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Achtung: Existiert das Docker-Volume schon, gilt das Passwort von damals (bisher: meinpasswort).
# Auf einem neuen Server hier ein eigenes, starkes Passwort wählen.
POSTGRES_PASSWORD=

# ---------- E-Mail (Gmail) ----------
# Gmail-Adresse und ein APP-Passwort (16 Zeichen, ohne Leerzeichen),
# erstellt unter: Google-Konto -> Sicherheit -> 2-Faktor-Authentifizierung -> App-Passwörter
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Angemeldet bleiben ----------
# Lange zufällige Zeichenkette (z. B. erzeugen mit:  openssl rand -hex 32)
REMEMBER_ME_KEY=

# ---------- Start-Benutzer ----------
# Passwort für das erste Admin-Konto (wird nur beim allerersten Start benutzt)
APP_ADMIN_PASSWORD=
# true = Test-Konten betreuer/student mit Passwort 123 (nur zum Ausprobieren!)
APP_DEMO_USERS=false
